{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checker_session_id", "source_to_page", "page_to_source", "manager_readability", "checks", "summary"],
  "properties": {
    "checker_session_id": {"type": "string", "minLength": 1},
    "source_to_page": {"enum": ["pass", "fail", "unsure"]},
    "page_to_source": {"enum": ["pass", "fail", "unsure"]},
    "manager_readability": {"enum": ["pass", "fail", "unsure"]},
    "summary": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "unsure"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
