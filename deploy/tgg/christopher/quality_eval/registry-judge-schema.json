{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks"],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "unsure"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
